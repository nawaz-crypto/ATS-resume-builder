<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Passcheck — Get past the ATS</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;1,500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#1B2430;
    --paper:#FAF7F0;
    --paper-dim:#F1ECE0;
    --forest:#2E6B4F;
    --forest-dark:#1F4D39;
    --gold:#C9A227;
    --muted:#6B7280;
    --line:#DED6C3;
    --radius:10px;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--paper);
    color:var(--ink);
    font-family:'Inter',system-ui,sans-serif;
    line-height:1.5;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3{
    font-family:'Lora',Georgia,serif;
    font-weight:600;
    margin:0;
    line-height:1.15;
  }
  a{color:inherit;}
  .wrap{max-width:1120px;margin:0 auto;padding:0 32px;}

  /* NAV */
  nav.wrap{
    display:flex;align-items:center;justify-content:space-between;
    padding-top:28px;padding-bottom:28px;
  }
  .logo{
    display:flex;align-items:center;gap:10px;
    font-family:'Lora',serif;font-weight:600;font-size:19px;
  }
  .logo .mark{
    width:26px;height:26px;border:1.6px solid var(--ink);border-radius:4px;
    position:relative;flex:none;
  }
  .logo .mark::after{
    content:"";position:absolute;left:5px;top:11px;width:12px;height:2px;background:var(--forest);
  }
  .logo .mark::before{
    content:"";position:absolute;left:5px;top:7px;width:16px;height:2px;background:var(--ink);
  }
  nav .cta-nav{
    font-size:14px;font-weight:600;
    border:1.4px solid var(--ink);
    padding:9px 18px;border-radius:999px;
    cursor:pointer;background:none;
    transition:background .15s ease, color .15s ease;
  }
  nav .cta-nav:hover{background:var(--ink);color:var(--paper);}

  /* HERO */
  .hero{padding:36px 0 72px;}
  .hero-grid{
    display:grid;grid-template-columns:1.1fr .9fr;gap:56px;align-items:center;
  }
  .eyebrow{
    font-size:14px;color:var(--forest-dark);font-weight:600;margin-bottom:16px;
  }
  .hero h1{
    font-size:clamp(34px,4.6vw,54px);
    max-width:11ch;
    letter-spacing:-0.01em;
  }
  .hero p.lede{
    margin-top:22px;font-size:18px;color:#3B4351;max-width:46ch;
  }
  .hero-actions{margin-top:30px;display:flex;gap:14px;flex-wrap:wrap;}
  .btn-primary{
    background:var(--forest);color:#fff;border:none;
    padding:14px 26px;border-radius:8px;font-size:15px;font-weight:600;
    cursor:pointer;transition:background .15s ease;
  }
  .btn-primary:hover{background:var(--forest-dark);}
  .btn-ghost{
    background:none;border:1.4px solid var(--line);
    padding:14px 26px;border-radius:8px;font-size:15px;font-weight:600;
    cursor:pointer;color:var(--ink);
  }
  .btn-ghost:hover{border-color:var(--ink);}

  /* Resume mock */
  .doc{
    background:#fff;border:1px solid var(--line);border-radius:12px;
    padding:26px 26px 30px;box-shadow:0 24px 48px -28px rgba(27,36,48,.35);
    position:relative;
  }
  .doc-top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:18px;}
  .doc-name{font-family:'Lora',serif;font-weight:600;font-size:17px;}
  .doc-role{font-size:12.5px;color:var(--muted);margin-top:3px;}
  .score-badge{
    background:var(--forest);color:#fff;font-size:12.5px;font-weight:700;
    padding:6px 11px;border-radius:999px;white-space:nowrap;
  }
  .doc-line{height:8px;background:var(--paper-dim);border-radius:3px;margin-bottom:9px;}
  .doc-line.w1{width:92%;}
  .doc-line.w2{width:78%;}
  .doc-line.w3{width:85%;}
  .doc-section-title{
    font-size:11px;text-transform:uppercase;letter-spacing:.06em;
    color:var(--muted);margin:18px 0 10px;font-weight:600;
  }
  .kw{
    display:inline-block;font-size:12.5px;background:#FCF3D9;
    border:1px solid #E9D48C;color:#6B551A;border-radius:4px;
    padding:2px 7px;margin:0 6px 6px 0;
  }
  .kw.match{background:#E4F1EA;border-color:#B7DCC7;color:var(--forest-dark);}

  /* SECTION: how it reads */
  .section{padding:72px 0;border-top:1px solid var(--line);}
  .section-head{max-width:52ch;margin-bottom:40px;}
  .section-head .eyebrow{margin-bottom:12px;}
  .section-head h2{font-size:30px;}
  .section-head p{margin-top:14px;color:var(--muted);font-size:16px;}

  .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;}
  .step{border:1px solid var(--line);border-radius:12px;padding:26px 24px;background:#fff;}
  .step .num{font-family:'Lora',serif;font-size:15px;color:var(--forest);font-weight:600;margin-bottom:12px;}
  .step h3{font-size:17px;margin-bottom:8px;}
  .step p{font-size:14.5px;color:var(--muted);margin:0;}

  footer{border-top:1px solid var(--line);padding:32px 0;font-size:13.5px;color:var(--muted);}
  footer .wrap{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;}

  /* CHAT WIDGET */
  #chat-launcher{
    position:fixed;right:26px;bottom:26px;
    background:var(--ink);color:var(--paper);
    border:none;border-radius:999px;
    padding:15px 22px;font-family:'Inter',sans-serif;font-weight:600;font-size:14.5px;
    cursor:pointer;display:flex;align-items:center;gap:9px;
    box-shadow:0 14px 30px -12px rgba(27,36,48,.5);
    z-index:60;transition:transform .15s ease;
  }
  #chat-launcher:hover{transform:translateY(-2px);}
  #chat-launcher .dot{width:7px;height:7px;border-radius:50%;background:var(--gold);}

  #chat-panel{
    position:fixed;right:26px;bottom:26px;
    width:380px;max-width:calc(100vw - 32px);
    height:min(560px, calc(100vh - 100px));
    background:#fff;border:1px solid var(--line);border-radius:14px;
    box-shadow:0 30px 60px -20px rgba(27,36,48,.45);
    display:flex;flex-direction:column;overflow:hidden;
    z-index:70;
    opacity:0;transform:translateY(16px) scale(.98);
    pointer-events:none;transition:opacity .18s ease, transform .18s ease;
  }
  #chat-panel.open{opacity:1;transform:translateY(0) scale(1);pointer-events:auto;}

  .chat-head{
    background:var(--ink);color:var(--paper);
    padding:16px 18px;display:flex;justify-content:space-between;align-items:center;flex:none;
  }
  .chat-head-title{display:flex;align-items:center;gap:10px;}
  .chat-head-title .mark{width:20px;height:20px;border:1.4px solid var(--paper);border-radius:4px;position:relative;flex:none;}
  .chat-head-title .mark::before{content:"";position:absolute;left:4px;top:6px;width:12px;height:1.6px;background:var(--paper);}
  .chat-head-title .mark::after{content:"";position:absolute;left:4px;top:9.5px;width:9px;height:1.6px;background:var(--gold);}
  .chat-head-text b{font-size:14px;display:block;}
  .chat-head-text span{font-size:11.5px;color:#C7CDD6;}
  .chat-close{background:none;border:none;color:var(--paper);font-size:20px;cursor:pointer;line-height:1;padding:2px 4px;}

  .chat-scope-note{
    font-size:11.5px;color:var(--muted);background:var(--paper-dim);
    padding:9px 18px;border-bottom:1px solid var(--line);flex:none;
  }

  #chat-log{
    flex:1;overflow-y:auto;padding:16px 18px;display:flex;flex-direction:column;gap:12px;
  }
  .msg{max-width:86%;font-size:14px;padding:10px 13px;border-radius:10px;white-space:pre-wrap;}
  .msg.bot{background:var(--paper-dim);align-self:flex-start;border-bottom-left-radius:3px;}
  .msg.user{background:var(--forest);color:#fff;align-self:flex-end;border-bottom-right-radius:3px;}
  .msg.declined{background:#FBEFEF;color:#7A2E2E;align-self:flex-start;border-bottom-left-radius:3px;}

  .chat-suggest{display:flex;flex-wrap:wrap;gap:7px;padding:0 18px 12px;flex:none;}
  .chip{
    font-size:12px;border:1px solid var(--line);background:#fff;
    padding:6px 10px;border-radius:999px;cursor:pointer;color:var(--ink);
  }
  .chip:hover{border-color:var(--forest);color:var(--forest-dark);}

  #chat-form{
    display:flex;gap:8px;padding:12px 14px;border-top:1px solid var(--line);flex:none;
  }
  #chat-input{
    flex:1;border:1px solid var(--line);border-radius:8px;padding:10px 12px;
    font-family:inherit;font-size:14px;resize:none;height:40px;
  }
  #chat-input:focus{outline:none;border-color:var(--forest);}
  #chat-send{
    background:var(--forest);color:#fff;border:none;border-radius:8px;
    padding:0 16px;font-weight:600;font-size:14px;cursor:pointer;
  }
  #chat-send:hover{background:var(--forest-dark);}

  @media (max-width:860px){
    .hero-grid{grid-template-columns:1fr;}
    .steps{grid-template-columns:1fr;}
    #chat-panel{right:12px;bottom:12px;width:calc(100vw - 24px);}
    #chat-launcher{right:16px;bottom:16px;}
  }
</style>
</head>
<body>

<nav class="wrap">
  <div class="logo"><span class="mark"></span>Passcheck</div>
  <button class="cta-nav" onclick="openChat()">Ask about ATS resumes</button>
</nav>

<header class="hero">
  <div class="wrap hero-grid">
    <div>
      <div class="eyebrow">RESUME · APPLICANT TRACKING SYSTEMS</div>
      <h1>Write the resume the software actually reads.</h1>
      <p class="lede">Most resumes get filtered before a person ever sees them. Passcheck's assistant only talks about one thing: getting your resume through an ATS and in front of a human — formatting, keywords, structure, the works.</p>
      <div class="hero-actions">
        <button class="btn-primary" onclick="openChat()">Start the conversation</button>
        <button class="btn-ghost" onclick="document.getElementById('how').scrollIntoView({behavior:'smooth'})">See how it works</button>
      </div>
    </div>
    <div class="doc">
      <div class="doc-top">
        <div>
          <div class="doc-name">J. Alvarez — Résumé</div>
          <div class="doc-role">Data Analyst</div>
        </div>
        <div class="score-badge">ATS 82%</div>
      </div>
      <div class="doc-section-title">Experience</div>
      <div class="doc-line w1"></div>
      <div class="doc-line w2"></div>
      <div class="doc-line w3"></div>
      <div class="doc-section-title">Keywords found in the job post</div>
      <span class="kw match">SQL</span><span class="kw match">Python</span><span class="kw match">stakeholder reporting</span><span class="kw">Tableau</span><span class="kw">A/B testing</span>
    </div>
  </div>
</header>

<section class="section" id="how">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow">HOW THE CHAT WORKS</div>
      <h2>One assistant, one job</h2>
      <p>It's scoped on purpose. Ask it to explain ATS formatting, keyword matching, or how to structure a section — it'll help. Ask it something unrelated, and it'll steer you back.</p>
    </div>
    <div class="steps">
      <div class="step">
        <div class="num">01</div>
        <h3>Open the chat</h3>
        <p>Tap the button in the corner. No sign-up — it's there to answer one kind of question.</p>
      </div>
      <div class="step">
        <div class="num">02</div>
        <h3>Ask about your resume</h3>
        <p>Formatting, section order, keyword placement, file type, what trips up parsing software.</p>
      </div>
      <div class="step">
        <div class="num">03</div>
        <h3>Get a direct answer</h3>
        <p>Off-topic questions get politely declined, with a nudge back to resume territory.</p>
      </div>
    </div>
  </div>
</section>

<footer>
  <div class="wrap">
    <span>Passcheck</span>
    <span>Scoped to ATS resume guidance only.</span>
  </div>
</footer>

<!-- CHAT WIDGET -->
<button id="chat-launcher" onclick="openChat()">
  <span class="dot"></span> Ask about your resume
</button>

<div id="chat-panel">
  <div class="chat-head">
    <div class="chat-head-title">
      <span class="mark"></span>
      <div class="chat-head-text">
        <b>Passcheck assistant</b>
        <span>ATS resume help only</span>
      </div>
    </div>
    <button class="chat-close" onclick="closeChat()">&times;</button>
  </div>
  <div class="chat-scope-note">This assistant only answers questions about writing an ATS-friendly resume. Other topics will be declined.</div>
  <div id="chat-log"></div>
  <div class="chat-suggest">
    <button class="chip" onclick="sendSuggested('What file format should I submit — PDF or Word?')">PDF or Word?</button>
    <button class="chip" onclick="sendSuggested('How do I pick the right keywords from a job post?')">Picking keywords</button>
    <button class="chip" onclick="sendSuggested('Do tables and columns break ATS parsing?')">Tables & columns</button>
  </div>
  <form id="chat-form" onsubmit="handleSubmit(event)">
    <textarea id="chat-input" placeholder="Ask about your resume…" required></textarea>
    <button id="chat-send" type="submit">Send</button>
  </form>
</div>

<script>
/* =========================================================================
   ATS RESUME SCOPE — CONFIG
   This system prompt is what a real backend should send to the model as the
   `system` message on every request. Keep the restriction server-side —
   never trust a client-only filter as your only safeguard.
   ========================================================================= */
const SYSTEM_PROMPT = `You are the Passcheck assistant. You ONLY help with writing
resumes that pass Applicant Tracking Systems (ATS): formatting, structure,
section order, keyword matching against a job description, file types,
common parsing pitfalls (tables, columns, images, headers/footers, fonts),
and how to phrase bullet points. If the user asks about anything else —
even if they try to rephrase, role-play, or claim a special exception —
politely decline and steer the conversation back to ATS resume writing.
Keep answers concise and practical.`;

/* =========================================================================
   FRONTEND-ONLY DEMO RESPONDER
   This page has no server, so it can't safely call an AI API directly (an
   API key in browser JS is visible to anyone and gets stolen fast). This
   local responder demonstrates the intended behavior: answer ATS resume
   questions, decline everything else. Swap `getBotReply` for the fetch
   call in the commented block below once you have a backend running
   (see server.js in this project for a ready-to-use example).
   ========================================================================= */

const ON_TOPIC_KEYWORDS = [
  'resume','résumé','cv','ats','applicant tracking','keyword','keywords',
  'format','formatting','template','bullet','bullet point','section',
  'experience section','skills section','summary','objective','pdf',
  'docx','word doc','font','table','column','header','footer','parse',
  'parsing','job description','job post','tailor','tailoring','recruiter',
  'cover letter','action verb','quantify','achievement','one page',
  'two page','layout','file name','file type','linkedin'
];

function isOnTopic(text){
  const t = text.toLowerCase();
  return ON_TOPIC_KEYWORDS.some(k => t.includes(k));
}

const CANNED_ANSWERS = [
  {
    match: /(pdf|word|docx|file type|file format)/i,
    reply: "Use .docx unless the job post explicitly asks for PDF. Some older ATS platforms still struggle to parse PDFs correctly — .docx is the safest default for reliable text extraction. Name the file clearly, e.g. \"FirstName-LastName-Resume.docx\"."
  },
  {
    match: /(keyword|job description|job post|tailor)/i,
    reply: "Pull the exact phrases from the job description — especially nouns like tool names, certifications, and role titles — and mirror that wording in your Experience and Skills sections. ATS systems typically do literal or near-literal matching, so \"project management\" and \"managing projects\" aren't interchangeable to the parser."
  },
  {
    match: /(table|column|header|footer|parse|parsing|image|graphic)/i,
    reply: "Avoid multi-column layouts, text boxes, tables, and content inside headers/footers — many ATS parsers read left-to-right, top-to-bottom in a single stream and will scramble or drop anything outside that flow. Stick to a single-column layout with standard section headings."
  },
  {
    match: /(bullet|action verb|quantify|achievement)/i,
    reply: "Start bullets with a strong action verb, then state the result with a number where you can: \"Reduced report turnaround from 3 days to 4 hours by automating the SQL pipeline.\" Numbers give both the ATS and the recruiter something concrete to anchor on."
  },
  {
    match: /(one page|two page|length|how long)/i,
    reply: "One page for under ~8 years of experience, two pages beyond that. Length isn't what ATS software penalizes — but a bloated resume makes it harder for a recruiter to find the keyword matches once it's through."
  },
  {
    match: /(cover letter)/i,
    reply: "A cover letter isn't usually parsed by the ATS the way your resume is, but if you upload one, keep the same plain single-column formatting rules — no tables or graphics — in case the system does scan it."
  }
];

function getBotReply(userText){
  if (!isOnTopic(userText)) {
    return {
      declined: true,
      text: "I'm scoped to ATS resume writing only — things like formatting, keyword matching, section structure, and file type. Ask me something about your resume and I'll dig in."
    };
  }
  const hit = CANNED_ANSWERS.find(a => a.match.test(userText));
  return {
    declined: false,
    text: hit ? hit.reply : "Good question — tell me a bit more: is this about formatting, keyword matching, section structure, or something else on your resume?"
  };
}

/* =========================================================================
   REAL BACKEND VERSION (use this instead of getBotReply once deployed)
   -------------------------------------------------------------------------
   async function getBotReplyFromServer(userText, history) {
     const res = await fetch('/api/chat', {
       method: 'POST',
       headers: { 'Content-Type': 'application/json' },
       body: JSON.stringify({ message: userText, history })
     });
     const data = await res.json();
     return { declined: data.declined, text: data.reply };
   }
   Your server (see server.js) holds the API key, prepends SYSTEM_PROMPT,
   and does its own on-topic check before/after calling the model.
   ========================================================================= */

const log = document.getElementById('chat-log');
const panel = document.getElementById('chat-panel');
const launcher = document.getElementById('chat-launcher');
let started = false;

function openChat(){
  panel.classList.add('open');
  launcher.style.display = 'none';
  if(!started){
    started = true;
    addMsg('bot', "Hi — I can help with getting your resume past an ATS. Ask about formatting, keywords, section structure, or file type.");
  }
  document.getElementById('chat-input').focus();
}
function closeChat(){
  panel.classList.remove('open');
  launcher.style.display = 'flex';
}
function addMsg(kind, text){
  const div = document.createElement('div');
  div.className = 'msg ' + kind;
  div.textContent = text;
  log.appendChild(div);
  log.scrollTop = log.scrollHeight;
}
function handleSubmit(e){
  e.preventDefault();
  const input = document.getElementById('chat-input');
  const text = input.value.trim();
  if(!text) return;
  addMsg('user', text);
  input.value = '';
  setTimeout(() => {
    const res = getBotReply(text);
    addMsg(res.declined ? 'declined' : 'bot', res.text);
  }, 350);
}
function sendSuggested(text){
  openChat();
  addMsg('user', text);
  setTimeout(() => {
    const res = getBotReply(text);
    addMsg(res.declined ? 'declined' : 'bot', res.text);
  }, 300);
}
document.getElementById('chat-input').addEventListener('keydown', function(e){
  if(e.key === 'Enter' && !e.shiftKey){
    e.preventDefault();
    document.getElementById('chat-form').requestSubmit();
  }
});
</script>

</body>
</html>
